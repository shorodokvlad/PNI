void __fastcall TForm1::Button1Click(TObject* Sender)
{
    OpenDialog1->Filter = "Bmp files(*.bmp)|*.BMP|JPEGimages\(*.jpg)|*.jpg;";
	Image1->Proportional = true;
	Image2->Proportional = true;
	if (OpenDialog1->Execute()) {
		if (!FileExists(OpenDialog1->FileName))
			return;
		AnsiString temp = ExtractFileExt(OpenDialog1->FileName);
		AnsiString Ext = temp.LowerCase();
		if (Ext.AnsiPos("jpg") > 0) // este un fisier jpg
		{
			TJPEGImage* myjpeg = new TJPEGImage();
			myjpeg->LoadFromFile(OpenDialog1->FileName);
			myjpeg->DIBNeeded();
            Image1->Picture->Bitmap->Assign(myjpeg);
			delete myjpeg;
		} else if (Ext.AnsiPos("bmp") > 0)
		{
			Image1->Picture->Bitmap->LoadFromFile(OpenDialog1->FileName);
		}

	}

	Graphics::TBitmap* source = new Graphics::TBitmap;
	source->Assign(Image1->Picture->Bitmap);
	source->PixelFormat = Image1->Picture->Bitmap->PixelFormat;

	Graphics::TBitmap* dest = new Graphics::TBitmap;
	dest->Height = source->Height;
	dest->Width = source->Width;
	dest->PixelFormat = source->PixelFormat;

	RGBTRIPLE* pixels;
	int histoSR[256] = {0};
	int histoSG[256] = {0};
	int histoSB[256] = {0};

	for (int x = 0; x < source->Height; x++) {
		 RGBTRIPLE* linie = (RGBTRIPLE*)source->ScanLine[x];
		 for (int y = 0; y < source->Width; y++) {
			   histoSR[linie[y].rgbtRed]++;
			   histoSG[linie[y].rgbtGreen]++;
			   histoSB[linie[y].rgbtBlue]++;
		 }
	}

	Chart1->Series[0]->Clear();
	Chart1->Series[1]->Clear();
	Chart1->Series[2]->Clear();


	for (int i = 0; i < 256; i++) {
		Chart1->Series[0]->AddXY(i, histoSR[i], "", clRed);
		Chart1->Series[1]->AddXY(i, histoSG[i], "", clGreen);
		Chart1->Series[2]->AddXY(i, histoSB[i], "", clBlue);
	}

	Chart1->Series[0]->Active = true;
	Chart1->Series[1]->Active = true;
	Chart1->Series[2]->Active = true;

}

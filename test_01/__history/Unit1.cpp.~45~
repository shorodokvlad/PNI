void __fastcall TForm1::Button4Click(TObject* Sender)
{
	/// de completat CW rotation + binarizare
    Graphics::TBitmap* source = new Graphics::TBitmap;
	source->Assign(Image1->Picture->Bitmap);
	source->PixelFormat = Image1->Picture->Bitmap->PixelFormat;

	Graphics::TBitmap* dest = new Graphics::TBitmap;
	dest->Height = source->Width;
	dest->Width = source->Height;
	dest->PixelFormat = source->PixelFormat;

	Graphics::TBitmap* dest2 = new Graphics::TBitmap;
	dest2->Height = source->Height;
	dest2->Width = source->Width;
	dest2->PixelFormat = source->PixelFormat;

	for (int x = 0; x < source->Width; x++) {
		for (int y = 0; y < source->Height; y++) {
			dest->Canvas->Pixels[y][source->Width - x - 1] = source->Canvas->Pixels[x][y];
		}
	}

	int editX = Edit1->Text.ToInt();
	double avg;

	for (int x = 0; x < dest->Width; x++) {
		RGBTRIPLE* linieS = (RGBTRIPLE*)dest->ScanLine[x];
		RGBTRIPLE* linieD = (RGBTRIPLE*)dest2->ScanLine[x];
		for (int y = 0; y < dest->Height; y++) {
			avg = (linieS[y].rgbtRed + linieS[y].rgbtGreen + linieS[y].rgbtBlue) / 3;

			if (avg < ((editX * 255) / 100)) {
				linieD[y].rgbtRed = 0;
				linieD[y].rgbtGreen = 0;
				linieD[y].rgbtBlue = 0;
			} else {
				linieD[y].rgbtRed = 255;
				linieD[y].rgbtGreen = 255;
				linieD[y].rgbtBlue = 255;
            }
		}
	}

	Image2->Picture->Bitmap->Assign(dest2);
	delete dest2;
	delete dest;
	delete source;
}

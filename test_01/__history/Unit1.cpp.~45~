void __fastcall TForm1::Button3Click(TObject* Sender)
{
/// de completat red and green
	Graphics::TBitmap* source = new Graphics::TBitmap;
	source->Assign(Image1->Picture->Bitmap);
	source->PixelFormat = Image1->Picture->Bitmap->PixelFormat;

	Graphics::TBitmap* dest = new Graphics::TBitmap;
	dest->Height = source->Height;
	dest->Width = source->Width;
	dest->PixelFormat = source->PixelFormat;

    int histoSR[256] = {0};
	int histoSG[256] = {0};
	int histoSB[256] = {0};

	for (int x = 0; x < source->Height; x++) {
		RGBTRIPLE* linieS = (RGBTRIPLE*)source->ScanLine[x];
		RGBTRIPLE* linieD = (RGBTRIPLE*)dest->ScanLine[x];
		for (int y = 0; y < source->Width; y++) {
			linieD[y].rgbtRed = linieS[y].rgbtRed;
			linieD[y].rgbtGreen = linieS[y].rgbtGreen;
			linieD[y].rgbtRed = 0;

			histoSR[linieS[y].rgbtRed]++;
			histoSG[linieS[y].rgbtGreen]++;
		}
	}

	Chart2->Series[0]->Clear();
	Chart2->Series[1]->Clear();

	for (int i = 0; i < 256; i++) {
		Chart2->Series[0]->AddXY(i, histoSR[i], "", clRed);
		Chart2->Series[1]->AddXY(i, histoSG[i], "", clGreen);
	}

	Chart2->Series[0]->Active = true;
	Chart2->Series[1]->Active = true;

	Image2->Picture->Bitmap->Assign(dest);

}
